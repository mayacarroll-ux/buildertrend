# Backend/serverless runtime configuration.
# Do not expose these values to browser-side HTML or JavaScript.
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
AIRTABLE_READ_PAT=
AIRTABLE_WRITE_PAT=

# Public frontend configuration.
# These are endpoint paths only; they must not contain Airtable credentials.
# Deployment can expose them as:
# window.BUILDERTREND_AIRTABLE_ENDPOINTS = { read: "...", write: "..." };
BUILDERTREND_AIRTABLE_READ_ENDPOINT=/api/airtable/members
BUILDERTREND_AIRTABLE_WRITE_ENDPOINT=/api/airtable/members
